{
  "name": "react-mindmap-template",
  "version": "0.1.0",
  "description": "A React Flow mindmap template with auto-layout using d3-flextree",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.1",
    "d3-flextree": "^2.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^11.1.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.2.53",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  },
  "keywords": [
    "react",
    "react-flow",
    "mindmap",
    "d3-flextree",
    "template"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/meo0/react-mindmap-template"
  }
}
